# Firebase Configuration
# Get these values from your Firebase Console → Project Settings → General → Your apps
# See FIREBASE_SETUP.md for detailed instructions

NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=            # optional
OPENROUTER_DEFAULT_MODEL=       # common fallback model

# --- Agent models (fallback defaults live in code when empty) ---
REDDIT_FILTER_MODEL=
REDDIT_MATCH_MODEL=
REDDIT_CREATE_MODEL=
REDDIT_UPDATE_MODEL=
REDDIT_CATEGORY_MODEL=

# --- Decisions (Jev / System One) ---
OPENROUTER_DECISIONS_BASE_URL=https://openrouter.ai/api
REDDIT_DECISIONS_MODEL=typesafe/jev-1.13

# --- Backend per agent (llm = legacy behaviour) ---
REDDIT_FILTER_BACKEND=llm        # jev | llm
REDDIT_MATCH_BACKEND=llm         # jev | llm
REDDIT_CATEGORY_BACKEND=llm      # jev | llm

# --- Confidence thresholds (0..1), default 0.8 ---
REDDIT_FILTER_THRESHOLD=0.8
REDDIT_MATCH_THRESHOLD=0.8
REDDIT_CATEGORY_THRESHOLD=0.8

# --- Pipeline ---
REDDIT_SUBREDDIT=AynThor
REDDIT_LOOKBACK_HOURS=24        # fetch window (in CI — the past day)
REDDIT_BATCH_SIZE=10
REDDIT_MAX_POSTS=0              # 0 = no limit
REDDIT_DRY_RUN=false

# --- Pull request ---
PR_BRANCH=reddit-pipeline/auto
PR_BASE=main
PR_LABELS=automation,reddit

# --- GitHub ---
# Personal access token used by the reddit pipeline to read repositories,
# READMEs and releases. Without it the GitHub API is limited to 60 requests
# per hour (per IP), which is easily exhausted by a single pipeline run.
# Create a classic PAT with the "public_repo" scope (or a fine-grained token
# with read-only "Contents" access) and set it locally:
#   export GITHUB_TOKEN=ghp_xxx
# In GitHub Actions the token is provided automatically.
GITHUB_TOKEN=
